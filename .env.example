# Optional licensed map provider. Set both before building; public values.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Address shown on the privacy page for data questions and deletion requests. Hidden when empty.
PRIVACY_CONTACT_EMAIL=
