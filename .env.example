APP_URL=https://your-domain.example
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kosova_report
MYSQL_USER=kosova_report
MYSQL_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@your-domain.example

# HTTPS base URL for R2 object URLs (prefer an access-controlled image host)
R2_IMAGE_BASE_URL=

# Admin panel: no default credentials. Generate a scrypt hash using the script.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional licensed map provider. Set both before building; public values.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
